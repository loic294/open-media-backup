{
  "name": "open-media-backup",
  "version": "0.1.0",
  "description": "Track and verify media backups from memory cards to final storage",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && vite build --mode demo",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,css,html}\"",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "ci:local": "node .github/scripts/local-ci.mjs",
    "test:rust": "node .github/scripts/local-ci.mjs --rust-only",
    "tauri:demo": "tauri dev --config src-tauri/tauri.demo.conf.json"
  },
  "author": "Loïc",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "lit": "^3.3.3",
    "lucide": "^1.50.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "daisyui": "^5.7.47",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "private": true
}
