{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Media Backup",
  "version": "0.1.0",
  "identifier": "app.openmediabackup.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Open Media Backup", "width": 1440, "height": 900, "minWidth": 1100, "minHeight": 700 }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": { "enable": true, "scope": ["$APPDATA/thumbnails/**", "$APPLOCALDATA/thumbnails/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
